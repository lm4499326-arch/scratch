        <p style="text-align: center;"><strong>Contacto:</strong> +57 350 7428275</p>
        <p class="texto-pequeno" style="text-align: center;">&copy; Todos los derechos reservados</p>
    </footer>

    <!-- Bootstrap 5 JS Bundle CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>